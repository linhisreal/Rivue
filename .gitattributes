# Auto detect text files and perform LF normalization
* text=auto

# Force LF for Luau files
*.luau text eol=lf
*.lua text eol=lf

# Force LF for shell scripts
*.sh text eol=lf

# Keep CRLF for Windows batch files
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.flv binary
*.fla binary
*.swf binary
*.gz binary
*.zip binary
*.7z binary
*.ttf binary
*.eot binary
*.woff binary
*.woff2 binary
*.rbxl binary
*.rbxlx binary
*.rbxm binary
*.rbxmx binary
